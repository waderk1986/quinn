{
  "name": "quinn-archibeque-for-sheriff",
  "version": "1.0.0",
  "description": "Campaign website for Quinn Archibeque, Delta County Sheriff 2026",
  "private": true,
  "scripts": {
    "lint:js": "eslint main.js",
    "lint:css": "stylelint style.css",
    "lint:html": "html-validate index.html story.html caucus.html endorsements.html",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "format": "prettier --write main.js style.css",
    "format:check": "prettier --check main.js style.css",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "lighthouse": "lhci autorun",
    "qa": "npm run lint && npm run format:check && npm run a11y",
    "qa:full": "npm run qa && npm run lighthouse",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": ["eslint", "prettier --check"],
    "*.css": ["stylelint", "prettier --check"],
    "*.html": ["html-validate"]
  },
  "overrides": {
    "semver": "^7.6.0",
    "tmp": "^0.2.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "html-validate": "^9.0.0",
    "husky": "^9.1.7",
    "linkinator": "^7.6.1",
    "lint-staged": "^16.4.0",
    "pa11y-ci": "^3.1.0",
    "prettier": "^3.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
